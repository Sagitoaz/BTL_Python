# Cấu hình cho server - Copy file này thành .env và điền giá trị thực

# ===== OLLAMA CONFIGURATION =====
# URL của Ollama server (bắt buộc)
# Ví dụ local: http://127.0.0.1:11434
# Ví dụ remote: https://your-ollama-server.com
# Ví dụ ngrok: https://abc123.ngrok.io
OLLAMA_URL=http://127.0.0.1:11434

# API Key cho Ollama Cloud (tùy chọn, để trống nếu dùng Ollama local)
OLLAMA_API_KEY=

# Model sử dụng (mặc định: qwen2.5-coder:7b)
MODEL=qwen2.5-coder:7b

# ===== SERVER CONFIGURATION =====
# Host và Port (mặc định: 0.0.0.0:9000)
# Render/Replit tự động set PORT, không cần đổi
HOST=0.0.0.0
PORT=9000

# API Key nội bộ của server này (để bảo vệ endpoints)
API_KEY=5conmeo

# ===== LLM SETTINGS =====
# Context window size (số token tối đa)
NUM_CTX=4096

# Timeout cho request tới Ollama (giây)
TIMEOUT_SECONDS=120

# ===== FEATURES =====
# Bật postprocessing để loại bỏ markdown và format code
POSTPROCESS_ENABLED=true

# ===== CORS =====
# Domains được phép gọi API (mặc định: *)
ALLOW_ORIGINS=*
